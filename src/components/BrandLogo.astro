---
interface Props {
  variant?: "horizontal" | "stacked" | "mark";
  class?: string;
}
const { variant = "horizontal", class: className = "" } = Astro.props;
const base = variant === "stacked" ? "a3s-labs-stacked" : variant === "mark" ? "a3s-labs-mark" : "a3s-labs-primary-horizontal";
---
<span class:list={["brand-logo", `brand-logo-${variant}`, className]} aria-hidden="true">
  <img class="brand-logo-light" src={`/brand/${base}.svg`} alt="" decoding="async" />
  <img class="brand-logo-dark" src={`/brand/${base}-on-dark.svg`} alt="" decoding="async" />
</span>
