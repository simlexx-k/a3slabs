---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductMedia from "../../components/ProductMedia.astro";
import SystemPreview from "../../components/SystemPreview.astro";
import { products, type Product } from "../../data/products";
import { caseStudyFor } from "../../data/caseStudies";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product; }
const { product } = Astro.props;
const caseStudy = caseStudyFor(product.slug);
---

<BaseLayout title={`${product.name} — A3S Labs`} description={product.summary} canonicalPath={`/products/${product.slug}`}>
  <section class={`product-hero section-pad accent-${product.accent}`}>
    <div class="shell product-hero-grid product-hero-grid-v2">
      <div class="product-hero-copy">
        <p class="eyebrow"><span>{product.eyebrow}</span><span>{product.status}</span></p>
        <h1>{product.name}</h1>
        <p class="product-lede">{product.summary}</p>
        <div class="product-hero-actions">
          {product.liveUrl && <a class="button button-primary" href={product.liveUrl} target="_blank" rel="noreferrer">Open live product <span>↗</span></a>}
          {caseStudy && <a class="button button-quiet" href={`/case-studies/${caseStudy.slug}`}>Read case study ↗</a>}
          {product.repoUrl && <a class="button button-quiet" href={product.repoUrl} target="_blank" rel="noreferrer">Inspect repository ↗</a>}
        </div>
      </div>
      <SystemPreview product={product} />
    </div>
  </section>

  <section class="section-pad section-rule">
    <div class="shell detail-grid detail-grid-v2">
      <div class="detail-copy">
        <p class="section-kicker">System brief</p>
        <h2>{product.description}</h2>
      </div>
      <aside class="runtime-card">
        <p class="section-kicker">Runtime</p>
        <strong>{product.runtime}</strong>
        <div class="runtime-stack">
          {product.stack.map((item) => <span>{item}</span>)}
        </div>
      </aside>
    </div>
  </section>

  <ProductMedia product={product} />

  <section class="section-pad detail-band">
    <div class="shell detail-columns detail-columns-v2">
      <div>
        <p class="section-kicker">Capabilities</p>
        <ol class="capability-numbered">
          {product.capabilities.map((item, index) => <li><span>0{index + 1}</span><b>{item}</b></li>)}
        </ol>
      </div>
      <div class="architecture-panel">
        <p class="section-kicker">System path</p>
        <div class="architecture-flow">
          {product.flow.map((step, index) => (
            <div>
              <span>0{index + 1}</span>
              <strong>{step}</strong>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad section-rule">
    <div class="shell proof-readout-grid">
      <div>
        <p class="section-kicker">Operational readout</p>
        <h2>Built around an actual signal path, not a capability checklist.</h2>
      </div>
      <dl class="product-readout-list">
        {product.readout.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {caseStudy && (
    <section class="section-pad case-outcome">
      <div class="shell narrative-grid">
        <div><p class="section-kicker">Engineering case study</p><h2>See the constraints behind the product.</h2></div>
        <div class="narrative-copy">
          <p>{caseStudy.problem}</p>
          <a class="button button-primary" href={`/case-studies/${caseStudy.slug}`}>Open case study <span>↗</span></a>
        </div>
      </div>
    </section>
  )}

  <section class="section-pad section-rule">
    <div class="shell next-system">
      <p>Continue through the lab.</p>
      <div><a href="/builds">Build log <span>↗</span></a><a href="/products">All products <span>↗</span></a></div>
    </div>
  </section>
</BaseLayout>
