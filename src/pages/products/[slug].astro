---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product; }
const { product } = Astro.props;
---

<BaseLayout title={`${product.name} — A3S Labs`} description={product.summary} canonicalPath={`/products/${product.slug}`}>
  <section class={`product-hero section-pad accent-${product.accent}`}>
    <div class="shell product-hero-grid">
      <div>
        <p class="eyebrow"><span>{product.eyebrow}</span><span>{product.status}</span></p>
        <h1>{product.name}</h1>
        <p class="product-lede">{product.summary}</p>
      </div>
      <div class="product-orbit" aria-hidden="true"><span>{product.name.slice(0, 2).toUpperCase()}</span></div>
    </div>
  </section>

  <section class="section-pad section-rule">
    <div class="shell detail-grid">
      <div class="detail-copy">
        <p class="section-kicker">System brief</p>
        <h2>{product.description}</h2>
      </div>
      <div class="detail-actions">
        {product.liveUrl && <a class="button button-primary" href={product.liveUrl} target="_blank" rel="noreferrer">Open live product <span>↗</span></a>}
        {product.repoUrl && <a class="button button-quiet" href={product.repoUrl} target="_blank" rel="noreferrer">Inspect repository ↗</a>}
      </div>
    </div>
  </section>

  <section class="section-pad detail-band">
    <div class="shell detail-columns">
      <div>
        <p class="section-kicker">Capabilities</p>
        <ol class="capability-numbered">
          {product.capabilities.map((item, index) => <li><span>0{index + 1}</span><b>{item}</b></li>)}
        </ol>
      </div>
      <div>
        <p class="section-kicker">Technology</p>
        <div class="stack-large">{product.stack.map((item) => <span>{item}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="section-pad section-rule">
    <div class="shell next-system">
      <p>Continue through the lab.</p>
      <a href="/products">All products <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
