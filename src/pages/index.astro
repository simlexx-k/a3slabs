---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { featuredProducts } from "../data/products";
import { recentBuilds } from "../data/builds";
---

<BaseLayout>
  <section class="hero section-pad">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span>A3S LABS</span><span>KENYA / 2026</span></p>
        <h1>Software for systems that <em>move, learn and operate.</em></h1>
        <p class="hero-lede">We build working products across applied AI, infrastructure, education, data systems and browser-native simulation. The work is the portfolio.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/products">Explore products <span>↗</span></a>
          <a class="button button-quiet" href="/builds">Read the build log</a>
        </div>
      </div>

      <aside class="lab-index" aria-label="A3S Labs product index">
        <div class="lab-index-head"><span>LAB INDEX</span><span>05 SYSTEMS</span></div>
        {featuredProducts.map((product, index) => (
          <a class={`lab-row accent-${product.accent}`} href={`/products/${product.slug}`}>
            <span class="lab-number">0{index + 1}</span>
            <span><b>{product.name}</b><small>{product.eyebrow}</small></span>
            <span class="lab-arrow">↗</span>
          </a>
        ))}
      </aside>
    </div>
  </section>

  <section class="section-pad section-rule" id="products">
    <div class="shell">
      <header class="section-heading split-heading">
        <div><p class="section-kicker">Selected systems</p><h2>Real products. Real constraints.</h2></div>
        <p>Instead of abstract capability claims, we show the software itself: what it observes, what it models, how it runs and what problem it is built to solve.</p>
      </header>
      <div class="product-grid">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="section-pad capability-band">
    <div class="shell capability-grid">
      <div class="capability-intro">
        <p class="section-kicker">Operating range</p>
        <h2>From data ingestion to interaction.</h2>
      </div>
      <div class="capability-list">
        <article><span>01</span><div><h3>Intelligence systems</h3><p>Multimodal extraction, classification, forecasting, search and structured evidence.</p></div></article>
        <article><span>02</span><div><h3>Infrastructure</h3><p>Containerized services, VPS operations, observability, secure tunnels and production delivery.</p></div></article>
        <article><span>03</span><div><h3>Education technology</h3><p>School operations, learner-facing tools, mobile surfaces and data-informed workflows.</p></div></article>
        <article><span>04</span><div><h3>Simulation</h3><p>Real-time browser graphics, deterministic dynamics, networking, sensors and interaction systems.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section-pad section-rule">
    <div class="shell proof-grid">
      <div class="proof-panel proof-dark">
        <p class="section-kicker">Architecture over slogans</p>
        <h2>We care about the system behind the screen.</h2>
        <p>The work spans server-side APIs, data models, schedulers, AI pipelines, real-time graphics, deployments, access boundaries and the user-facing layer.</p>
        <a class="text-link" href="/engineering">Engineering practice ↗</a>
      </div>
      <div class="proof-console" aria-label="Example A3S Labs system architecture">
        <div class="console-head"><span>system.map</span><span>live architecture</span></div>
        <pre><code>PUBLIC SIGNALS
     │
     ▼
INGESTION ──► STRUCTURED DATA
     │              │
     ▼              ▼
  MODELS        PRODUCT API
                    │
               ┌────┴────┐
               ▼         ▼
             WEB       MOBILE

secure delivery · observable runtime</code></pre>
      </div>
    </div>
  </section>

  <section class="section-pad home-builds">
    <div class="shell">
      <header class="section-heading split-heading">
        <div><p class="section-kicker">Recent build log</p><h2>Progress with repository evidence.</h2></div>
        <p>Selected milestones are tied to real commits, so the portfolio shows how systems change—not only the state they ended up in.</p>
      </header>
      <div class="home-build-list">
        {recentBuilds.map((entry) => (
          <a class="home-build-row" href={entry.commitUrl} target="_blank" rel="noreferrer">
            <time datetime={entry.date}>{entry.date}</time>
            <small>{entry.project}</small>
            <b>{entry.title}</b>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="hero-actions"><a class="button button-quiet" href="/builds">Open full build log</a></div>
    </div>
  </section>

  <section class="section-pad research-strip">
    <div class="shell research-grid">
      <div>
        <p class="section-kicker">Research in practice</p>
        <h2>Applied ML should meet a real signal.</h2>
      </div>
      <div class="research-copy">
        <p>BeeUnity combines acoustic classification with weather, NDVI and hive context. Other work spans topology-aware 3D segmentation, computer vision, forecasting and model evaluation.</p>
        <a class="button button-quiet" href="/research">Explore research</a>
      </div>
    </div>
  </section>

  <section class="section-pad closing-cta">
    <div class="shell closing-grid">
      <p class="section-kicker">A3S / CONNECT</p>
      <h2>Inspect the work.<br />Then start with the problem.</h2>
      <div>
        <p>Use the public products and repositories to understand how A3S Labs builds, then bring the technical problem that needs solving.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">Start a conversation <span>↗</span></a>
          <a class="button button-quiet" href="https://github.com/simlexx-k" target="_blank" rel="noreferrer">Open GitHub ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
