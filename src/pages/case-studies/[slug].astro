---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductMedia from "../../components/ProductMedia.astro";
import { caseStudies, type CaseStudy } from "../../data/caseStudies";
import { products } from "../../data/products";

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

interface Props { study: CaseStudy; }
const { study } = Astro.props;
const product = products.find((item) => item.slug === study.productSlug);
---

<BaseLayout title={`${study.title} — A3S Labs`} description={study.problem} canonicalPath={`/case-studies/${study.slug}`}>
  <section class:list={["case-hero", "section-pad", `accent-${study.accent}`]}>
    <div class="shell case-hero-grid">
      <div>
        <p class="eyebrow"><span>{study.eyebrow}</span><span>{product?.status ?? "A3S Labs"}</span></p>
        <h1>{study.title}</h1>
        <p class="case-hero-lede">{study.problem}</p>
        <div class="hero-actions">
          {product && <a class="button button-primary" href={`/products/${product.slug}`}>Product brief <span>↗</span></a>}
          {product?.liveUrl && <a class="button button-quiet" href={product.liveUrl} target="_blank" rel="noreferrer">Open live product ↗</a>}
          {product?.repoUrl && <a class="button button-quiet" href={product.repoUrl} target="_blank" rel="noreferrer">Repository ↗</a>}
        </div>
      </div>

      <div class="case-architecture" aria-label={`${study.title} architecture`}>
        <div class="case-architecture-head"><span>SYSTEM PATH</span><span>{study.architecture.length} STAGES</span></div>
        <ol>
          {study.architecture.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><b>{step}</b></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section-pad section-rule">
    <div class="shell narrative-grid">
      <div><p class="section-kicker">Approach</p><h2>Build the path, not only the interface.</h2></div>
      <div class="narrative-copy"><p>{study.approach}</p></div>
    </div>
  </section>

  {product && <ProductMedia product={product} title="Project evidence" />}

  <section class="section-pad detail-band">
    <div class="shell">
      <header class="section-heading split-heading case-section-heading">
        <div><p class="section-kicker">Engineering decisions</p><h2>Constraints turned into product choices.</h2></div>
        <p>These are implementation decisions visible in the repository architecture and recent development history.</p>
      </header>
      <div class="decision-grid">
        {study.decisions.map((decision, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{decision.title}</h3>
            <p>{decision.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad section-rule">
    <div class="shell evidence-layout">
      <div>
        <p class="section-kicker">Repository evidence</p>
        <h2>Inspect the work.</h2>
        <p class="evidence-intro">Selected commits make the chronology auditable. They are not a complete changelog; they are concrete points where the system changed materially.</p>
      </div>
      <div class="evidence-list">
        {study.evidence.map((item, index) => (
          <a href={item.url} target="_blank" rel="noreferrer">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><b>{item.label}</b><p>{item.detail}</p></div>
            <i>↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad case-outcome">
    <div class="shell narrative-grid">
      <div><p class="section-kicker">Outcome</p><h2>What the system became.</h2></div>
      <div class="narrative-copy"><p>{study.outcome}</p><a class="text-link" href="/builds">Continue through the build log ↗</a></div>
    </div>
  </section>
</BaseLayout>
